# Database (Supabase Postgres)
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used in email links
APP_URL=https://classes.saarthilife.com

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Saarthi Classes <hello@classes.saarthilife.com>"
EMAIL_REPLY_TO=hello@classes.saarthilife.com
# Where new join-request alerts go (defaults to EMAIL_REPLY_TO)
ADMIN_NOTIFICATION_EMAIL=

# Google Calendar / Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://classes.saarthilife.com/api/integrations/google/callback
GOOGLE_CALENDAR_ACCOUNT=classes@saarthilife.com

# Razorpay (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard > Webhooks for /api/razorpay/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron: protects /api/cron/weekly-report (Sunday parent reports). Any long random string.
CRON_SECRET=
